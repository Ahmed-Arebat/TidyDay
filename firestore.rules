rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidTask(task) {
      let fields = ['title', 'notes', 'dueDate', 'completed', 'createdAt'];
      return task.keys().hasAll(fields)
        && task.keys().hasOnly(fields)
        && task.title is string
        && task.title.size() > 0
        && task.title.size() <= 120
        && task.title == task.title.trim()
        && task.notes is string
        && task.notes.size() <= 1000
        && (task.dueDate == null || (task.dueDate is string
          && task.dueDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')))
        && task.completed is bool
        && task.createdAt is timestamp;
    }

    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidTask(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && isValidTask(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
